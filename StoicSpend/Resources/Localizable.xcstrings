    "You have power over your mind — not outside events.\nRealize this, and you will find strength." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast Macht über deinen Geist — nicht über äußere Ereignisse. Erkenne dies, und du wirst Kraft finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have power over your mind — not outside events.\nRealize this, and you will find strength."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes poder sobre tu mente, no sobre los acontecimientos externos. Date cuenta de esto y encontrarás fuerza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as pouvoir sur ton esprit — non sur les événements extérieurs. Réalise cela, et tu trouveras la force."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai potere sulla tua mente, non sugli eventi esterni. Realizza questo e troverai forza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你の心には力がある——外部の出来事ではない。これを悟れば、力を見出せる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 마음에는 힘이 있다 — 외부 사건이 아니다. 이를 깨달으면 힘을 얻으리라."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt macht over je geest — niet over externe gebeurtenissen. Besef dit en je zult kracht vinden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem poder sobre sua mente — não sobre eventos externos. Perceba isso e encontrará força."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zihnin üzerinde gücün var — dış olaylar üzerinde değil. Bunu fark et ve güç bulacaksın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có quyền lực trên tâm trí mình — không phải trên sự việc bên ngoài. Nhận ra điều này, bạn sẽ tìm thấy sức mạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有力量掌控自己的心靈——而非外界事物。认识到这一点，你将找到力量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你有力量掌控自己的心靈——而非外界事物。認識到這一點，你將找到力量。"
          }
        }
      }
    },
    "Your \"Already Have\" list is empty. Start there later — for now, continue if you truly need this." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine „Already Have“-Liste ist leer. Füll sie später aus — wenn du es jetzt wirklich brauchst, mach weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your \"Already Have\" list is empty. Start there later — for now, continue if you truly need this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu lista «Already Have» está vacía. Complétala más tarde; por ahora, continúa si realmente lo necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta liste « Already Have » est vide. Remplis-la plus tard — pour l’instant, continue si tu en as vraiment besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua lista «Already Have» è vuota. Compilala più tardi — per ora, continua se ne hai davvero bisogno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Already Have」リストは空です。後で入力しましょう——今どうしても必要なら続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Already Have」 목록이 비어 있어요. 나중에 채우고— 지금 정말 필요하면 계속하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je „Already Have“-lijst is leeg. Vul hem later in — als je het nu echt nodig hebt, ga dan verder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua lista «Already Have» está vazia. Preencha depois — por ora, continue se realmente precisar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Already Have” listen boş. Sonraya bırak — şimdi gerçekten ihtiyacın varsa devam et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danh sách „Already Have“ của bạn trống. Hãy thêm sau — còn bây giờ, tiếp tục nếu bạn thật sự cần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的「已拥有」清单还是空的。以后再填——现在如果真的需要，就继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的「已擁有」清單還是空的。以後再填——現在如果真的需要，就繼續。"
          }
        }
      }
    },
    "Your data will be stored in your personal iCloud and synced across your devices. It still never touches our servers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten werden in deinem persönlichen iCloud gespeichert und geräteübergreifend synchronisiert. Unsere Server werden weiterhin nie berührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your data will be stored in your personal iCloud and synced across your devices. It still never touches our servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se guardarán en tu iCloud personal y se sincronizarán entre tus dispositivos. Seguirán sin tocar nunca nuestros servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données seront stockées dans votre iCloud personnel et synchronisées sur vos appareils. Elles ne passeront jamais par nos serveurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati saranno salvati nel tuo iCloud personale e sincronizzati sui tuoi dispositivi. Non toccheranno mai i nostri server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データは個人のiCloudに保存され、デバイス間で同期されます。当社のサーバーには一切送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터는 개인 iCloud에 저장되고 기기 간에 동기화됩니다. 여전히 우리 서버에는 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens worden opgeslagen in je persoonlijke iCloud en gesynchroniseerd op je apparaten. Ze raken onze servers nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados serão armazenados no seu iCloud pessoal e sincronizados entre seus dispositivos. Eles nunca passarão pelos nossos servidores."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verileriniz kişisel iCloud'ınızda saklanacak ve cihazlarınız arasında eşitlenecek. Yine de sunucularımıza hiçbir zaman ulaşmayacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dữ liệu của bạn sẽ được lưu trong iCloud cá nhân và đồng bộ giữa các thiết bị. Vẫn không bao giờ đi qua máy chủ của chúng tôi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据将存入你的个人 iCloud 并在各设备间同步，依然绝不会经过我们的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料將存入你的個人 iCloud 並在各裝置間同步，依然絕不會經過我們的伺服器。"
          }
        }
      }
    },
