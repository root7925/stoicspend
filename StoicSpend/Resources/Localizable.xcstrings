    "先放 72 小时。到期还想要，再让它进来。" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege es 72 Stunden beiseite. Wenn du es danach noch willst, lass es herein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set it aside for 72 hours. If you still want it when time's up, let it in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo reposar 72 horas. Si al terminar aún lo quieres, déjalo entrar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일단 72시간 두고 보세요. 기한이 지나도 갖고 싶으면 그때 들여보내요."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti da parte per 72 ore. Se a fine tempo lo vorrai ancora, fallo entrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose-le 72 heures. Si tu le veux encore après, laisse-le entrer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず72時間置いておく。期限が来てまだ欲しければ、その時入れて。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg het 72 uur opzij. Wil je het daarna nog, laat het dan binnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe de lado por 72 horas. Se ainda quiser quando o prazo acabar, aí deixe entrar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "72 saat bir kenara koy. Süre dolunca hâlâ istiyorsan, o zaman içeri al."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để đó 72 giờ đã. Hết hạn mà vẫn muốn thì cứ cho vào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先放 72 小时。到期还想要，再让它进来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先放 72 小時。到期還想要，再讓它進來。"
          }
        }
      }
    },
