    "quote.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reichtum besteht nicht darin, großen Besitz zu haben, sondern wenige Wünsche."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wealth consists not in having great possessions, but in having few wants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riqueza no consiste en tener grandes posesiones, sino en tener pocos deseos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richesse ne consiste pas à avoir de grandes possessions, mais à avoir peu de désirs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricchezza non consiste nell'avere grandi possessi, ma nell'avere pochi desideri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富とは多くの財産を持つことではなく、少ない欲望を持つことにある。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부는 많은 소유물을 가지는 것이 아니라, 적은 욕망을 가지는 데 있다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rijkdom bestaat niet uit het hebben van veel bezittingen, maar uit het hebben van weinig verlangens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A riqueza não consiste em ter grandes posses, mas em ter poucos desejos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenginlik çok mala sahip olmakta değil, az arzu taşımaktadır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giàu có không nằm ở việc sở hữu nhiều tài sản, mà ở việc có ít ham muốn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "财富不在于拥有大量财产，而在于欲望很少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "財富不在於擁有大量財產，而在於慾望很少。"
          }
        }
      }
    },
    "quote.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht derjenige ist arm, der zu wenig hat, sondern derjenige, der nach mehr verlangt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is not the man who has too little, but the man who craves more, that is poor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es pobre el que tiene poco, sino el que anhela más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas l'homme qui a trop peu qui est pauvre, mais celui qui désire plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è povero chi ha troppo poco, ma chi brama di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貧しいのは持たざる者ではなく、さらに求める者である。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가난한 것은 적게 가진 자가 아니라, 더 많이 갈망하는 자이다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet hij die te weinig heeft is arm, maar hij die meer begeert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é pobre quem tem pouco, mas quem deseja mais."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoksul olan az şeye sahip olan değil, daha çoğunu arzulayandır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người nghèo không phải là người có quá ít, mà là người khao khát nhiều hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贫穷的不是拥有太少的人，而是渴望更多的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貧窮的不是擁有太少的人，而是渴望更多的人。"
          }
        }
      }
    },
    "quote.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dich verbessern willst, begnüge dich damit, für töricht und dumm gehalten zu werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you want to improve, be content to be thought foolish and stupid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si quieres mejorar, conformáte con ser considerado tonto y estúpido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu veux t'améliorer, contente-toi d'être considéré comme fou et stupide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuoi migliorare, accontentati di essere considerato sciocco e stupido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上したいなら、愚かで馬鹿だと思われることに甘んじよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "발전하고 싶다면, 어리석고 바보로 여겨지는 데 만족하라."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je jezelf wilt verbeteren, wees dan tevreden om voor dwaas en dom te worden aangezien."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quiser melhorar, contente-se em ser considerado tolo e estúpido."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelişmek istiyorsan, aptal ve salak olarak görülmeye razı ol."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu bạn muốn tiến bộ, hãy chấp nhận bị coi là ngu ngốc và dốt nát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你想进步，就甘愿被认为愚蠢和无知。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你想進步，就甘願被認為愚蠢和無知。"
          }
        }
      }
    },
    "quote.4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reichtum ist der Sklave des Weisen, der Herr des Toren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wealth is the slave of a wise man, the master of a fool."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riqueza es esclava del sabio y ama del necio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richesse est l'esclave du sage, la maîtresse du fou."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricchezza è schiava del saggio, padrona dello stolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富は賢者の奴隷、愚か者の主人である。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부는 현자의 노예이자 어리석은 자의 주인이다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rijkdom is de slaaf van de wijze, de meester van de dwaas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A riqueza é escrava do sábio, senhora do tolo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenginlik bilgenin kölesi, ahmağın efendisidir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Của cải là nô lệ của người khôn ngoan, là chủ nhân của kẻ ngu dốt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "财富是智者的奴隶，愚者的主人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "財富是智者的奴隸，愚者的主人。"
          }
        }
      }
    },
    "quote.5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weise ist, wer nicht um das trauert, was er nicht hat, sondern sich über das freut, was er hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He is a wise man who does not grieve for the things which he has not, but rejoices for those which he has."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sabio quien no se aflige por lo que no tiene, sino que se alegra por lo que tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est sage celui qui ne s'afflige pas de ce qu'il n'a pas, mais se réjouit de ce qu'il a."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È saggio chi non si addolora per ciò che non ha, ma si rallegra per ciò che ha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賢者とは持たざるものに悲しまず、持てるものに喜ぶ者である。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현자는 가지지 못한 것을 슬퍼하지 않고, 가진 것에 기뻐하는 자이다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijs is hij die niet treurt om wat hij niet heeft, maar zich verheugt om wat hij wel heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É sábio quem não se entristece pelo que não tem, mas se alegra pelo que tem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge, sahip olmadığı şeyler için üzülmeyen, sahip olduklarıyla sevinen kimsedir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người khôn ngoan là người không buồn phiền về những gì không có, mà vui vẻ về những gì mình có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智者不为没有的事物悲伤，而为已有的事物欢喜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "智者不為沒有的事物悲傷，而為已有的事物歡喜。"
          }
        }
      }
    },
    "quote.6" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der größte Reichtum ist, mit wenig zufrieden zu leben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The greatest wealth is to live content with little."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayor riqueza es vivir conforme con poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plus grande richesse est de vivre content avec peu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La più grande ricchezza è vivere contenti con poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大の富は、少ないもので満足して生きることである。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 큰 부는 적은 것에 만족하며 사는 것이다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grootste rijkdom is tevreden leven met weinig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maior riqueza é viver contente com pouco."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En büyük zenginlik, azla yetinerek yaşamaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giàu có nhất là sống biết đủ với ít ỏi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大的财富是知足常乐。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最大的財富是知足常樂。"
          }
        }
      }
    },
    "quote.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht der Tod ist es, was man fürchten sollte, sondern dass man nie zu leben begonnen hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is not death that a man should fear, but he should fear never beginning to live."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es la muerte lo que un hombre debe temer, sino nunca haber empezado a vivir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce n'est pas la mort qu'un homme devrait craindre, mais de n'avoir jamais commencé à vivre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è la morte che un uomo dovrebbe temere, ma il non aver mai cominciato a vivere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恐れるべきは死ではなく、生涯生き始めなかったことである。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두려워해야 할 것은 죽음이 아니라, 결코 살기 시작하지 않은 것이다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet de dood moet een man vrezen, maar dat hij nooit is begonnen met leven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é a morte que se deve temer, mas sim nunca ter começado a viver."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnsanın korkması gereken ölüm değil, hiç yaşamaya başlamamış olmasıdır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều con người nên sợ không phải là cái chết, mà là chưa từng bắt đầu sống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人应该害怕的不是死亡，而是从未开始真正生活。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人應該害怕的不是死亡，而是從未開始真正生活。"
          }
        }
      }
    },
    "quote.8" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand hat die Macht, alles zu haben, was er will, aber er hat die Macht, nicht nach dem zu verlangen, was er nicht hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No person has the power to have everything they want, but it is in their power not to want what they don't have."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie tiene el poder de tener todo lo que quiere, pero sí está en su poder no desear lo que no tiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nul n'a le pouvoir d'avoir tout ce qu'il veut, mais il est en son pouvoir de ne pas vouloir ce qu'il n'a pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha il potere di avere tutto ciò che vuole, ma è in suo potere non desiderare ciò che non ha."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰も望むものすべてを手に入れる力はないが、持たざるものを欲しがらない力はある。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누구도 원하는 모든 것을 가질 힘은 없지만, 가지지 못한 것을 원하지 않을 힘은 있다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand heeft de macht om alles te hebben wat hij wil, maar het is in zijn macht om niet te verlangen wat hij niet heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém tem o poder de ter tudo o que quer, mas está em seu poder não desejar o que não tem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiç kimse istediği her şeye sahip olma gücüne sahip değildir, ancak sahip olmadığı şeyi istememe gücüne sahiptir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ai có quyền lực để có mọi thứ mình muốn, nhưng có quyền lực để không khao khát những gì mình không có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有人能拥有想要的一切，但可以不去渴望没有的东西。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有人能擁有想要的一切，但可以不去渴望沒有的東西。"
          }
        }
      }
    },
    "quote.9" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reichtum kann das Herz nicht füllen; er füllt nur den Geldbeutel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wealth is unable to fill the heart; it only fills the purse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riqueza no puede llenar el corazón; solo llena la bolsa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richesse ne peut remplir le cœur ; elle ne remplit que la bourse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ricchezza non può riempire il cuore; riempie solo il portafoglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "富は心を満たすことはできない。財布を満たすだけだ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부는 마음을 채울 수 없다. 지갑만 채울 뿐이다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rijkdom kan het hart niet vullen; het vult alleen de beurs."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A riqueza não consegue preencher o coração; apenas enche a bolsa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zenginlik kalbi dolduramaz; sadece cüzdanı doldurur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Của cải không thể lấp đầy trái tim; nó chỉ lấp đầy túi tiền."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "财富无法填满心灵，只能填满钱袋。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "財富無法填滿心靈，只能填滿錢袋。"
          }
        }
      }
    },
    "quote.10" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ganze Zukunft liegt in der Ungewissheit: lebe sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The whole future lies in uncertainty: live immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el futuro es incierto: vive ahora mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout l'avenir est incertain : vis immédiatement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intero futuro è incerto: vivi subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来はすべて不確かである。今すぐ生きよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미래는 온통 불확실하다. 지금 당장 살아라."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hele toekomst is onzeker: leef nu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o futuro é incerto: viva imediatamente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm gelecek belirsizlik içinde: hemen yaşa."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toàn bộ tương lai đều không chắc chắn: hãy sống ngay lúc này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整个未来充满不确定性：活在当下。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整個未來充滿不確定性：活在當下。"
          }
        }
      }
    },
    "Read and edit your ledger from a browser on the same network. Data never leaves your local network." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ledger über einen Browser im selben Netzwerk lesen und bearbeiten. Daten verlassen nie Ihr lokales Netzwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read and edit your ledger from a browser on the same network. Data never leaves your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee y edita tu registro desde un navegador en la misma red. Los datos nunca salen de tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez et modifiez votre registre depuis un navigateur sur le même réseau. Les données ne quittent jamais votre réseau local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi e modifica il registro da un browser sulla stessa rete. I dati non lasciano mai la rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じネットワーク上のブラウザから帳簿を閲覧・編集できます。データがローカルネットワークの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 네트워크의 브라우저에서 가계부를 보고 편집합니다. 데이터는 로컬 네트워크를 벗어나지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk en bewerk je administratie via een browser in hetzelfde netwerk. Gegevens verlaten nooit je lokale netwerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia e edite seu registro em um navegador na mesma rede. Os dados nunca saem da sua rede local."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı ağdaki bir tarayıcıdan defterinizi görüntüleyin ve düzenleyin. Veriler yerel ağınızdan asla çıkmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem và chỉnh sửa sổ sách từ trình duyệt trong cùng mạng. Dữ liệu không bao giờ rời mạng cục bộ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一网络下用浏览器查看和编辑账本，数据绝不离开你的局域网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在同一網路下用瀏覽器查看和編輯帳本，資料絕不離開你的區域網路。"
          }
        }
      }
    },
