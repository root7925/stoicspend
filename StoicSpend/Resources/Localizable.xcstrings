    "This will permanently delete all expenses, reflections, and settings. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ausgaben, Reflexionen und Einstellungen werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all expenses, reflections, and settings. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todos los gastos, reflexiones y ajustes. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement toutes les dépenses, réflexions et paramètres. Irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo eliminerà definitivamente tutte le spese, riflessioni e impostazioni. Non può essere annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての支出、振り返り、設定が完全に削除されます。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 지출, 성찰, 설정이 영구 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle uitgaven, reflecties en instellingen worden permanent verwijderd. Onomkeerbaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá permanentemente todas as despesas, reflexões e configurações. Não pode ser desfeito."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm harcamalar, reflexionlar ve ayarlar kalıcı olarak silinecek. Geri alınamaz."
          }
