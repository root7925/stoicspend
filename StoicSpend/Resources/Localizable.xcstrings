    "A snapshot of your current data will be taken automatically — you can undo after importing." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Ihren aktuellen Daten wird automatisch ein Schnappschuss erstellt — nach dem Import können Sie widerrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A snapshot of your current data will be taken automatically — you can undo after importing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tomará una copia automática de sus datos actuales: podrá deshacer después de importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un instantané de vos données actuelles sera créé automatiquement — vous pourrez annuler après l'importation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà creata automaticamente un'istantanea dei dati attuali: potrai annullare dopo l'importazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のデータのスナップショットが自動的に作成されます。インポート後には取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 데이터의 스냅샷이 자동으로 생성됩니다. 가져온 후에 실행 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt automatisch een snapshot van uw huidige gegevens gemaakt — u kunt na het importeren ongedaan maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um snapshot dos seus dados atuais será criado automaticamente — você pode desfazer após importar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut verilerinizin anlık görüntüsü otomatik olarak alınacak — içe aktardıktan sonra geri alabilirsiniz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản chụp dữ liệu hiện tại sẽ được tạo tự động — bạn có thể hoàn tác sau khi nhập."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
