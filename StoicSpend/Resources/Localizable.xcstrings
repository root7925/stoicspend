    "ai.fallback.followup" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Ausgabe dieser Woche brachte dich dem Menschen näher, der du sein willst?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looking back at this week's spending, which expense brought you closest to the person you want to become?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué gasto de esta semana te acercó más a la persona que quieres ser?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle dépense cette semaine vous a rapproché de la personne que vous voulez être ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quale spesa di questa settimana ti ha avvicinato alla persona che vuoi essere?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週の支出で、なりたい自分に最も近づいたのはどれですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 지출 중, 당신이 되고 싶은 사람에 가장 가까웠던 것은?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welke uitgave deze week bracht je dichter bij de persoon die je wilt zijn?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qual despesa desta semana te aproximou da pessoa que você quer ser?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu haftanın hangi harcaması seni olmak istediğin insana en çok yaklaştırdı?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khoản chi tuần nào khiến bạn thấy gần nhất với con người bạn muốn trở thành?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回顾本周的消费，哪一笔让你感到最接近你想成为的那个人？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回顧本週的消費，哪一筆讓你感到最接近你想成為的那個人？"
          }
        }
      }
    },
    "ai.fallback.followupReply" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm dir einen Moment, um das zu verarbeiten. Welchen kleinen Schritt könntest du morgen tun?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a moment to sit with that. What small step could you take tomorrow?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómate un momento para asimilarlo. ¿Qué pequeño paso podrías dar mañana?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez un moment pour digérer cela. Quel petit pas pourriez-vous faire demain ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenditi un momento per riflettere. Quale piccolo passo potresti fare domani?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それを受け止める瞬間を持って。明日、どんな小さな一歩を踏めますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠시 그것과 함께 머물러 보세요. 내일 어떤 작은 한 걸음을 내딛을 수 있을까요?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem even de tijd om dat te laten bezinken. Welke kleine stap kun je morgen zetten?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reserve um momento para refletir sobre isso. Que pequeno passo você poderia dar amanhã?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu hazmetmek için bir an ver. Yarın hangi küçük adımı atabilirsin?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy dành một khoảnh khắc để suy ngẫm về điều đó. Ngày mai bạn có thể thực hiện bước nhỏ nào?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给自己片刻去感受这件事。明天你能迈出怎样一小步？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "給自己片刻去感受這件事。明天你能邁出怎樣一小步？"
          }
        }
      }
    },
    "ai.fallback.resilience" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konzentriere dich auf das, was du kontrollieren kannst: deine Ausgaben, deine Entscheidungen, deine Vorbereitung. Den Rest überlasse dem Schicksal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus on what you can control: your spending, your choices, your preparation. The rest, leave to fate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concéntrate en lo que puedes controlar: tus gastos, tus decisiones, tu preparación. El resto, al destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrez-vous sur ce que vous pouvez contrôler : vos dépenses, vos choix, votre préparation. Le reste, confiez-le au destin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentrati su ciò che puoi controllare: le tue spese, le tue scelte, la tua preparazione. Il resto, lascialo al destino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールできることに集中せよ：支出、選択、準備。残りは運に任せよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통제할 수 있는 것에 집중하세요: 당신의 지출, 선택, 준비. 나머지는 운명에 맡기세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richt je op wat je kunt controleren: je uitgaven, je keuzes, je voorbereiding. De rest, laat het aan het lot over."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concentre-se no que você pode controlar: suas despesas, suas escolhas, sua preparação. O resto, deixe ao destino."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrol edebildiğine odaklan: harcamaların, seçimlerin, hazırlığın. Gerisini kadere bırak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tập trung vào những gì bạn có thể kiểm soát: chi tiêu, lựa chọn, sự chuẩn bị. Phần còn lại, hãy để cho số phận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注于你能控制的：你的支出，你的选择，你的准备。其余的，交给命运。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "專注於你能控制的：你的支出，你的選擇，你的準備。其餘的，交給命運。"
          }
        }
      }
    },
