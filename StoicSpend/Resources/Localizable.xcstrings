    "No subscription. No in-app purchases. All features are free, and every future update will stay free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Abo, keine In-App-Käufe. Alle Funktionen sind kostenlos – und jede künftige Aktualisierung bleibt es auch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No subscription. No in-app purchases. All features are free, and every future update will stay free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin suscripciones ni compras en la app. Todas las funciones son gratis, y cada actualización futura seguirá siéndolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans abonnement ni achats intégrés. Toutes les fonctionnalités sont gratuites, et toutes les futures mises à jour le resteront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun abbonamento, nessun acquisto in-app. Tutte le funzioni sono gratuite e ogni aggiornamento futuro lo rimarrà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクなし、アプリ内課金なし。すべての機能が無料で、今後のアップデートもずっと無料です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독도 인앱 결제도 없습니다. 모든 기능이 무료이며, 앞으로의 업데이트도 항상 무료입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen abonnement, geen in-app-aankopen. Alle functies zijn gratis, en elke toekomstige update blijft dat ook."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem assinatura, sem compras no app. Todos os recursos são gratuitos — e toda atualização futura também será."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelik yok, uygulama içi satın alma yok. Tüm özellikler ücretsizdir ve gelecekteki her güncelleme de öyle kalacaktır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gói thuê bao, không mua hàng trong ứng dụng. Mọi tính năng đều miễn phí, và mọi bản cập nhật sau này cũng sẽ miễn phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有订阅，没有内购。所有功能现在全部免费，未来的每次更新也永远免费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有訂閱，沒有內購。所有功能現在全部免費，未來的每次更新也永遠免費。"
          }
        }
      }
    },
